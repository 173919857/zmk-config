#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
//#include <dt-bindings/zmk/rgb.h>
//#include <dt-bindings/zmk/outputs.h>
//#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC    &kp N1  &kp N2    &kp N3          &kp N4       &kp N5        &kp N6     &kp N7    &kp N8          &kp N9     &kp N0     &kp MINUS  &kp EQUAL
                &kp TAB    &kp Q   &kp W     &kp E           &kp R        &kp T         &kp Y      &kp U     &kp I           &kp O      &kp P      &kp BSPC
                &kp CAPS   &kp A   &kp S     &kp D           &kp F        &kp G         &kp H      &kp J     &kp K           &kp L      &kp ENTER
                &kp LSHFT  &kp Z   &kp X     &kp C           &kp V        &kp B         &kp N      &kp M     &mt RSHFT HOME  &kp UP     &kp END
                &kp LCTRL  &to 2   &kp LWIN  &mt LALT COMMA  &lt 1 SPACE  &mt RALT DOT  &kp RCTRL  &kp LEFT  &kp DOWN        &kp RIGHT
            >;
        };

        layer_1 {
            bindings = <
                &kp GRAVE   &kp C_AC_SCROLL_UP  &kp C_AC_SCROLL_DOWN  &kp PG_UP       &kp PG_DN            &bootloader   &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4  &kp SCROLLLOCK  &kp KP_NUMLOCK
                &kp TILDE   &kp F1              &kp F2                &kp F3          &kp F4               &kp F5        &kp F6        &none           &kp LBKT        &kp RBKT         &kp BSLH      &kp DEL
                &bt BT_CLR  &kp F7              &kp F8                &kp F9          &kp F10              &kp F11       &kp F12       &kp SEMI        &kp SQT         &kp SLASH        &kp K_APP
                &kp LSHFT   &kp C_MUTE          &kp C_VOL_DN          &kp C_VOL_UP    &kp C_AL_CALCULATOR  &kp INS       &kp PSCRN     &none           &mkp LCLK       &mmv MOVE_UP     &mkp RCLK
                &kp LCTRL   &none               &kp LWIN              &mt LALT COMMA  &none                &mt RALT DOT  &kp RCTRL     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
            >;
        };

        layer_2 {
            bindings = <
                &kp ESC    &kp N1  &kp N2    &kp N3          &kp N4       &kp N5        &kp N6     &kp N7    &kp N8          &kp N9     &kp N0     &kp MINUS  &kp EQUAL
                &kp TAB    &kp Q   &kp W     &kp E           &kp R        &kp T         &kp Y      &kp U     &kp I           &kp O      &kp P      &kp BSPC
                &kp CAPS   &kp A   &kp S     &kp D           &kp F        &kp G         &kp H      &kp J     &kp K           &kp L      &kp ENTER
                &kp LSHFT  &kp Z   &kp X     &kp C           &kp V        &kp B         &kp N      &kp M     &mt RSHFT HOME  &kp UP     &kp END
                &kp LCTRL  &to 0   &kp LALT  &mt LCMD COMMA  &lt 3 SPACE  &mt RCMD DOT  &kp RALT   &kp LEFT  &kp DOWN        &kp RIGHT
            >;
        };

        layer_3 {
            bindings = <
                &kp GRAVE   &kp C_AC_SCROLL_UP  &kp C_AC_SCROLL_DOWN  &kp PG_UP       &kp PG_DN            &none         &none         &none           &none           &none            &none         &none    &none
                &kp TILDE   &kp F1              &kp F2                &kp F3          &kp F4               &kp F5        &kp F6        &none           &kp LBKT        &kp RBKT         &kp BSLH      &kp DEL
                &bt CAPS    &kp F7              &kp F8                &kp F9          &kp F10              &kp F11       &kp F12       &kp SEMI        &kp SQT         &kp SLASH        &kp ENTER
                &kp LSHFT   &none               &none                 &none           &none                &none         &none         &none           &mkp LCLK       &mmv MOVE_UP     &mkp RCLK
                &kp LCTRL   &none               &kp LEFT_ALT          &mt LCMD COMMA  &none                &mt RCMD DOT  &kp RALT      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
            >;
        };
    };
};
